# The base image is pinned by version and digest; Dependabot updates both.

# Build client frontend
FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS fe-builder
LABEL maintainer="support@yivi.app"

ENV PATH=/app/node_modules/.bin:$PATH

WORKDIR /app
COPY ./client ./

RUN npm ci
RUN npm run build

##################################

# Build server backend
FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS be-builder
LABEL maintainer="support@yivi.app"

ENV PATH=/app/node_modules/.bin:$PATH

WORKDIR /app

## Compile typescript to js in /dist
COPY ./server/package.json ./
COPY ./server/package-lock.json ./
COPY ./server/tsconfig.json ./
COPY ./server/src ./src

RUN npm ci
RUN npm run build

## Install production modules in /dist/node_modules
RUN cp package.json package-lock.json ./dist/
RUN npm ci --omit=dev --prefix ./dist

## Copy static assets in /dist
COPY ./server/static ./dist/static

##################################

# Build server and include frontend (docroot is set to ../client in config.json)
FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5

COPY --from=be-builder /app/dist/. /server
COPY --from=fe-builder /app/dist/. /client

WORKDIR /server

# The app only needs the node binary at runtime, so after installing the latest
# OS security updates and preparing the user and the sessions directory:
# - remove the package managers that ship with the base image (npm, yarn,
#   corepack), so their bundled dependencies are not part of the image;
# - remove busybox (the shell and its tools) and the packages that need it.
# This must stay the last shell RUN instruction: there is no shell afterwards.
RUN apk upgrade --no-cache && \
    adduser -D irma && \
    mkdir sessions && \
    chown irma:irma sessions && \
    rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
        /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-* \
        /usr/local/bin/docker-entrypoint.sh /root/.npm && \
    apk del --no-network ssl_client busybox busybox-binsh alpine-baselayout

# Removing the base layout also removed the (empty) /tmp; recreate it.
RUN ["node", "-e", "fs.mkdirSync('/tmp'); fs.chmodSync('/tmp', 0o1777)"]

USER irma

ENV NODE_ENV=production

# The entrypoint of the base image is a shell script; run node directly.
ENTRYPOINT []
CMD ["node","./app.js"]
EXPOSE 8000
