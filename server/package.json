        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.4",
        "express-session": "^1.19.0",
        "helmet": "^8.2.0",
        "http-proxy-middleware": "^3.0.7",
        "lusca": "^1.7.0",
        "reflect-metadata": "^0.2.2",
        "session-file-store": "^1.5.0",
        "tslib": "^2.1.0",
        "typedi": "^0.10.0",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.17.3",
        "@types/jest": "^30.0.0",
        "@types/lusca": "^1.7.5",
        "@types/node": "^26.1.0",
        "@types/session-file-store": "^1.2.1",
        "@types/supertest": "^7.2.0",
        "@types/winston": "^2.4.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.2.1",
        "eslint-plugin-prettier": "^5.5.6",
        "fast-glob": "^3.2.6",
        "glob-parent": "^6.0.2",
        "globals": "^15.15.0",
        "jest": "^30.4.2",
        "nodemon": "^3.1.10",
        "prettier": "^3.9.4",
